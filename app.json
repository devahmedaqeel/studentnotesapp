{
  "expo": {
    "name": "StudentNotes",
    "slug": "student-notes",
    "scheme": "studentnotes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F19"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.studentnotes.app",
      "infoPlist": {
        "NSCameraUsageDescription": "StudentNotes needs camera access to scan your handwritten and printed notes.",
        "NSPhotoLibraryUsageDescription": "StudentNotes needs access to your photos to import document images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F19"
      },
      "package": "com.studentnotes.app",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "StudentNotes needs camera access to scan your handwritten and printed notes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "StudentNotes needs access to your photos to import document images."
        }
      ],
      "expo-sqlite",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "eece5076-3bfe-4fb2-89a7-07e03d760bed"
      }
    }
  }
}
